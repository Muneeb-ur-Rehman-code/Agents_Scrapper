# ── PostgreSQL ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scraper_db
DB_USER=scraper_user
DB_PASSWORD=change_me

# ── Flask ──────────────────────────────────────────────────
FLASK_SECRET_KEY=change_me
FLASK_PORT=5000

# ── App ────────────────────────────────────────────────────
HEADLESS=false
# Realtor.com Kasada bypass (recommended on VPS):
# REALTOR_HEADLESS=false
# VPS/datacenter IPs are usually hard-blocked — use a residential proxy for Realtor only:
# REALTOR_PROXY_SERVER=http://user:pass@gate.provider.com:10000
# Or apply to all scrapers:
# PROXY_SERVER=http://user:pass@host:port
# Max parallel scrape jobs (each opens Chrome — keep low on small VPS)
MAX_CONCURRENT_SCRAPES=5
OUTPUT_DIR=./output